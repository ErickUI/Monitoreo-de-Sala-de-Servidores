from(bucket: "sala_servidores")
  |> range(start: -10m)
  |> filter(fn: (r) => r._measurement == "lecturas_sala")
  |> filter(fn: (r) => r._field == "seq" or r._field == "temperatura" or r._field == "luz_porcentaje" or r._field == "estado_temp" or r._field == "estado_luz")
  |> pivot(rowKey: ["_time"], columnKey: ["_field"], valueColumn: "_value")
  |> keep(columns: ["_time", "seq", "temperatura", "luz_porcentaje", "estado_temp", "estado_luz"])
  |> group()
  |> sort(columns: ["_time"], desc: true)
  |> limit(n: 20)
